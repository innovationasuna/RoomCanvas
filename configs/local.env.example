# Copy to local.env (gitignored), edit, then explicitly source it.
export VIEWFORGE_ROOT=/path/to/viewforge-mvsam3d
export CUDA_VISIBLE_DEVICES=GPU-your-authorized-gpu-uuid
# All applications sharing this GPU should use the same lock path.
export VIEWFORGE_GPU_LOCK=/path/to/shared/viewforge-gpu.lock
export TORCH_CUDA_ARCH_LIST=8.6
# UTC+8, including minimal containers without tzdata; change for your timezone.
export TZ=CST-8
