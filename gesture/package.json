{
  "name": "roomcanvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8800 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8800 --strictPort",
    "test": "vitest run",
    "prepare:vision": "node scripts/prepare-vision.mjs",
    "check:resources": "node scripts/check-resources.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "fflate": "0.8.3",
    "google-auth-library": "11.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
