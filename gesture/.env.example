# Google Cloud 中创建的 Web 应用 Client ID；不是 Client Secret。
# 配置后重启 npm run dev。完整说明见 docs/google-login.md。
GOOGLE_CLIENT_ID=

# 可选：另开本地验收环境时指定编辑器地址和独立数据目录。
# 未配置时使用 http://127.0.0.1:7870，数据存放在仓库旁 .roomcanvas-local/。
# VITE_ROOMCANVAS_EDITOR_ORIGIN=http://127.0.0.1:7890
# ROOMCANVAS_DATA_ROOT=/absolute/path/to/roomcanvas-test-data
