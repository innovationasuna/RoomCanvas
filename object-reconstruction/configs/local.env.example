# Copy to local.env (gitignored); scripts/setup.sh does this for you. Explicitly source it before scripts/env.sh.
export VIEWFORGE_ROOT=/path/to/ViewForge
# Everything below is optional. Defaults: the GPU with the most free memory at start-up, a lock at
# $VIEWFORGE_ROOT/cache/gpu.lock, the build architecture of that GPU, and the system time zone.
# On a shared server pin one authorized GPU, and give every app on that card the same lock path:
# export CUDA_VISIBLE_DEVICES=GPU-your-authorized-gpu-uuid
# export VIEWFORGE_GPU_LOCK=/path/to/shared/viewforge-gpu.lock
# export TORCH_CUDA_ARCH_LIST=8.6
# Minimal containers without tzdata (UTC+8 shown):
# export TZ=CST-8
