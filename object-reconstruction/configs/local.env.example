# Copy to local.env (gitignored); scripts/setup.sh does this for you. Explicitly source it before scripts/env.sh.
export VIEWFORGE_ROOT=/path/to/ViewForge
# Defaults use the card with most free memory and a per-UUID lock under ~/.cache/roomcanvas/gpu-locks.
# Pin an authorized card on a shared server. Set the same lock directory on both services across accounts:
# export CUDA_VISIBLE_DEVICES=GPU-your-authorized-gpu-uuid
# export ROOMCANVAS_GPU_LOCK_DIR=/path/to/shared/roomcanvas-gpu-locks
# Existing VIEWFORGE_GPU_LOCK settings continue to be honored.
# export TORCH_CUDA_ARCH_LIST=8.6
# Minimal containers without tzdata (UTC+8 shown):
# export TZ=CST-8
