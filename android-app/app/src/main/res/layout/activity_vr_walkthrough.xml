<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- AR Engine 泵帧用：位于 SceneView 下方，只取位姿，不显示相机画面 -->
    <android.opengl.GLSurfaceView
        android:id="@+id/arPoseView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 房间渲染层：不透明，第一人称相机由虚拟状态每帧合成 -->
    <io.github.sceneview.SceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 画面暗角：让边缘控件与 3D 场景分开，不接收触摸 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_vignette"
        android:clickable="false"
        android:focusable="false" />

    <!-- 方向键 + 升降键 + 右半屏滑动转向：单 View 统一处理多指 -->
    <com.hausen3d.arviewer.vr.VrTouchControlsView
        android:id="@+id/vrTouchControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvVrStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_status_chip"
        android:letterSpacing="0.02"
        android:text=""
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 开始页：模型预览之上的玻璃卡片。
         横屏手机可用高度只有 ~430dp，卡片内容比这还高，
         用 NestedScrollView 包住：放得下时居中，放不下时可滚动，不会再被裁掉。 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/startOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_start_scrim"
        android:clickable="true"
        android:fillViewport="true"
        android:focusable="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC0E1A26"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="#26FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="14dp"
                android:paddingEnd="28dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="3D RECONSTRUCTION WALKTHROUGH"
                    android:textColor="@color/accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.06"
                    android:text="房间漫游"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/accent" />

                <TextView
                    android:id="@+id/tvModelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_model_chip"
                    android:drawableStart="@drawable/ic_folder"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/accent"
                    android:ellipsize="middle"
                    android:maxWidth="320dp"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    style="@style/Widget.ARViewer.PrimaryButton"
                    android:layout_marginTop="12dp"
                    android:text="开始漫游"
                    android:textColor="@color/on_accent"
                    app:backgroundTint="@color/accent"
                    app:icon="@drawable/ic_play"
                    app:iconTint="@color/on_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickRoom"
                    style="@style/Widget.ARViewer.SecondaryButton"
                    android:layout_marginTop="6dp"
                    android:text="选择房间模型"
                    app:icon="@drawable/ic_folder" />

                <TextView
                    android:id="@+id/tvStartHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="正在等待 AR 跟踪…"
                    android:textColor="@color/text_faint"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 右上角菜单：4 秒无操作自动收起 -->
    <LinearLayout
        android:id="@+id/menuRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 用 ImageButton 而非 Material 图标按钮：Material3 IconButton 自带左右 4dp inset，
             会把 44dp 按钮压成 36×44 的椭圆，内置图标也不在圆心。这里自己画正圆底，
             22dp 图标靠 padding 精确居中。 -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_menu_button"
            android:contentDescription="菜单"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu"
            app:tint="@color/text_primary" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/menuPanel"
            android:layout_width="208dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_panel"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#26FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:text="漫游控制"
                    android:textColor="@color/accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecenter"
                    style="@style/Widget.ARViewer.MenuItem"
                    android:text="重新居中"
                    app:icon="@drawable/ic_recenter" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReset"
                    style="@style/Widget.ARViewer.MenuItem"
                    android:text="回到起点"
                    app:icon="@drawable/ic_home" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeed"
                    style="@style/Widget.ARViewer.MenuItem"
                    android:text="速度 1.0×"
                    app:icon="@drawable/ic_speed" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="6dp"
                    android:background="#1FFFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExitVr"
                    style="@style/Widget.ARViewer.MenuItem"
                    android:text="结束漫游"
                    app:icon="@drawable/ic_exit" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</FrameLayout>
