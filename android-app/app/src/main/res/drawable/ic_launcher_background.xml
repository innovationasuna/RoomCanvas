<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标底层：深色玻璃渐变 + 青蓝色柔光，与 App 内 bg_deep / accent 同一色系 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="64.8"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#FF0E2433"
                    android:offset="0" />
                <item
                    android:color="#FF081320"
                    android:offset="0.55" />
                <item
                    android:color="#FF04080D"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 中心青蓝光晕，让房间主体从深色背景里浮起来 -->
    <path android:pathData="M54,52 m-46,0 a46,46 0 1,0 92,0 a46,46 0 1,0 -92,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="46"
                android:type="radial">
                <item
                    android:color="#5735C8DC"
                    android:offset="0" />
                <item
                    android:color="#1C35C8DC"
                    android:offset="0.55" />
                <item
                    android:color="#0035C8DC"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
